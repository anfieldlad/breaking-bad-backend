MONGO_URI=your_mongodb_atlas_uri
API_KEY=your_secret_api_key

# Optional settings with defaults
DB_NAME=rag_app
COLLECTION_NAME=documents
DEBUG=false

# Master password for the document cleanup endpoint (DELETE /api/documents).
# Sent by clients via X-Cleanup-Password. Leave empty to DISABLE cleanup entirely.
CLEANUP_PASSWORD=

# PDF processing
MAX_PAGES_PER_PDF=20

# Vector search
VECTOR_INDEX_NAME=vector_index
VECTOR_SEARCH_CANDIDATES=50
VECTOR_SEARCH_LIMIT=5

# ----- LLM provider selection -----
# Each can be set independently to "gemini" or "openai".
# "openai" = any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, LM Studio,
# Together, Groq, etc.), selected via OPENAI_BASE_URL.
CHAT_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Gemini credentials (required when a provider above is "gemini")
GEMINI_API_KEY=your_gemini_api_key

# OpenAI-compatible credentials (required when a provider above is "openai")
OPENAI_API_KEY=your_openai_api_key
# For self-hosted endpoints, point this at your server, e.g.:
#   http://localhost:11434/v1   (Ollama)
#   http://localhost:8000/v1    (vLLM)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model settings (must match the selected provider)
# Gemini examples: CHAT_MODEL=gemini-2.5-flash-lite  EMBEDDING_MODEL=gemini-embedding-001
# OpenAI examples: CHAT_MODEL=gpt-4o-mini            EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
